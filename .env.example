# ── LLM backend ──────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
ROUTER_MODEL=meta/llama-3.1-8b-instruct
CONTENT_MODEL=meta/llama-3.3-70b-instruct

# Fallbacks de desarrollo (si NVIDIA está en rate limit)
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ── LLM response cache ────────────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./.llm_cache

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── NER ──────────────────────────────────────────────────────────────────────
NER_MODEL=es_core_news_sm

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=5

# ── Image generation ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

NVIDIA_IMAGE_MODEL=flux.1-schnell

VISUAL_OUTPUT_DIR=./generated_visuals
VISUAL_MOCK_ENABLED=true