# ── LLM backend ──────────────────────────────────────────────────────────────
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
ROUTER_MODEL=meta/llama-3.1-8b-instruct
CONTENT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Destila el extracto en escenas visuales antes del generador de imágenes
VISUAL_PLANNER_MODEL=meta/llama-3.1-8b-instruct

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Los tres roles (ROUTER/CONTENT/VISUAL_PLANNER) son los que mandan: pon en ellos
# el id EXACTO que devuelva GET /v1/models. OPENAI_MODEL solo lo usa el proveedor
# genérico get_llm_provider(), que el agente no toca.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.4-mini
# ROUTER_MODEL=gpt-5.4-mini
# CONTENT_MODEL=gpt-5.4-mini
# VISUAL_PLANNER_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # solo si usas Azure/proxy/gateway

# Fallbacks de desarrollo (si NVIDIA está en rate limit)
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ── LLM response cache ────────────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./.llm_cache

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ── NER ──────────────────────────────────────────────────────────────────────
NER_MODEL=es_core_news_sm

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=5

# ── Image generation ─────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

NVIDIA_IMAGE_MODEL=flux.1-schnell

VISUAL_OUTPUT_DIR=./generated_visuals
VISUAL_MOCK_ENABLED=true

CORS_ALLOW_ORIGINS=*
